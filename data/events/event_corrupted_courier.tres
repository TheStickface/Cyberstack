[resource]
script = ExtResource("1_ev")
id = "event_corrupted_courier"
title = "Corrupted Data Courier"
story_text = "In a steam-vented alleyway, you find a wounded street courier clutching a smoking cyberdeck. Corporate bounty hunters are closing in, and the courier offers to offload hot contraband."
theme_color = Color(0, 0.95, 0.83, 1)
choices = [SubResource("Resource_choice_1"), SubResource("Resource_choice_2")]
