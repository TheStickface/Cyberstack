[resource]
script = ExtResource("1_ev")
id = "event_viral_containment_breach"
title = "Bio-Hazard Quarantine"
story_text = "Red emergency strobes flash as pressurized decontamination sirens wail. A bio-pharma dispensary vault door is cracked open, venting virulent green aerosol mist."
