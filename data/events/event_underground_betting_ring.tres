[resource]
script = ExtResource("1_ev")
id = "event_underground_betting_ring"
title = "Neon Pit Wagers"
story_text = "The roar of cybernetically enhanced spectators echoes from an underground fighting cage. A holographic odds board shifts in real time as an oily bookmaker waves you over."
