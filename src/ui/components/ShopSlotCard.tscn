[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/ui/components/ShopSlotCard.gd" id="1_slot"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_shop_slot"]
bg_color = Color(0.06, 0.05, 0.12, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.7, 0.3, 1, 0.8)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="ShopSlotCard" type="PanelContainer"]
custom_minimum_size = Vector2(170, 160)
offset_right = 170.0
offset_bottom = 160.0
mouse_filter = 0
theme_override_styles/panel = SubResource("StyleBoxFlat_shop_slot")
script = ExtResource("1_slot")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="TypeLabel" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.75, 1)
theme_override_font_sizes/font_size = 9
text = "OPERATIVE"

[node name="CostLabel" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.85, 0, 1)
theme_override_font_sizes/font_size = 9
text = "3 CREDITS"
horizontal_alignment = 2

[node name="NameLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 12
text = "Blitz"
clip_text = true

[node name="DetailsLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.8, 0.8, 0.88, 1)
theme_override_font_sizes/font_size = 9
text = "[TANK | RUNNERS]
HP: 750 | AD: 38"
autowrap_mode = 2
clip_text = true

[node name="BuyBtn" type="Button" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "BUY (3 CR)"

[connection signal="pressed" from="Margin/VBox/BuyBtn" to="." method="_on_buy_btn_pressed"]
