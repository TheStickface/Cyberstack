[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/ui/components/OperativeCard.gd" id="1_card"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(0.06, 0.05, 0.12, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0, 0.85, 0.75, 0.8)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="OperativeCard" type="PanelContainer"]
custom_minimum_size = Vector2(185, 205)
offset_right = 185.0
offset_bottom = 205.0
mouse_filter = 0
theme_override_styles/panel = SubResource("StyleBoxFlat_card")
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="NameLabel" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 12
text = "Blitz"
clip_text = true

[node name="RoleBadge" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.7, 0.9, 1)
theme_override_font_sizes/font_size = 9
text = "TANK"

[node name="FactionBadge" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.4, 1, 1)
theme_override_font_sizes/font_size = 9
text = "RUNNERS"

[node name="StatsLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.92, 1)
theme_override_font_sizes/font_size = 8
text = "HP: 750 | AD: 38 | AP: 20"

[node name="AbilityLabel" type="Label" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.65, 0.75, 1)
theme_override_font_sizes/font_size = 8
text = "Nitro Rush"
clip_text = true

[node name="SlotsHeader" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.5, 0.65, 1)
theme_override_font_sizes/font_size = 8
text = "AUGMENT SLOTS:"

[node name="SlotsContainer" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Actions" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 10
theme_override_constants/separation = 4

[node name="ToggleFieldBtn" type="Button" parent="Margin/VBox/Actions"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 9
text = "BENCH"

[node name="SellBtn" type="Button" parent="Margin/VBox/Actions"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
theme_override_font_sizes/font_size = 9
text = "SELL (2 CR)"

[connection signal="pressed" from="Margin/VBox/Actions/ToggleFieldBtn" to="." method="_on_toggle_field_pressed"]
[connection signal="pressed" from="Margin/VBox/Actions/SellBtn" to="." method="_on_sell_pressed"]
