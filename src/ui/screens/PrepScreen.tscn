[connection signal="pressed" from="Margin/VBox/TopBar/LockInBtn" to="." method="_on_lock_in_pressed"]
[connection signal="pressed" from="Margin/VBox/MainBody/BoardArea/ShopSection/ShopControls/RerollBtn" to="." method="_on_reroll_pressed"]
