[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/ui/screens/PrepScreen.gd" id="1_prep"]
[ext_resource type="PackedScene" path="res://src/ui/components/SynergyTrackerHUD.tscn" id="2_hud"]

[node name="PrepScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_prep")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.015, 0.05, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TopBar" type="HBoxContainer" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_override_constants/separation = 16

[node name="DistrictLabel" type="Label" parent="Margin/VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.3, 1, 1)
theme_override_font_sizes/font_size = 14
text = "DISTRICT 1: SLUM MARKET"

[node name="CrewCountLabel" type="Label" parent="Margin/VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 14
text = "CREW: 1 / 2"

[node name="GoldLabel" type="Label" parent="Margin/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.85, 0, 1)
theme_override_font_sizes/font_size = 15
text = "CREDITS: 12"

[node name="LockInBtn" type="Button" parent="Margin/VBox/TopBar"]
custom_minimum_size = Vector2(190, 34)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.1, 0.4, 1)
theme_override_font_sizes/font_size = 12
text = "▶ [LOCK IN & DEPLOY]"

[node name="MainBody" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="BoardArea" type="VBoxContainer" parent="Margin/VBox/MainBody"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="FieldSection" type="VBoxContainer" parent="Margin/VBox/MainBody/BoardArea"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Label" type="Label" parent="Margin/VBox/MainBody/BoardArea/FieldSection"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 10
text = "FIELDED OPERATIVES (Click empty slots to equip selected augment):"

[node name="FieldScroll" type="ScrollContainer" parent="Margin/VBox/MainBody/BoardArea/FieldSection"]
custom_minimum_size = Vector2(0, 215)
layout_mode = 2
vertical_scroll_mode = 0

[node name="FieldContainer" type="HBoxContainer" parent="Margin/VBox/MainBody/BoardArea/FieldSection/FieldScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="BenchAndTray" type="HBoxContainer" parent="Margin/VBox/MainBody/BoardArea"]
