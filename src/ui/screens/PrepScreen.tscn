[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/ui/screens/PrepScreen.gd" id="1_prep"]
[ext_resource type="PackedScene" path="res://src/ui/components/SynergyTrackerHUD.tscn" id="2_hud"]

[node name="PrepScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_prep")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.015, 0.06, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 12.0
offset_right = -16.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8

[node name="TopBar" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="DistrictLabel" type="Label" parent="VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.3, 1, 1)
theme_override_font_sizes/font_size = 14
text = "DISTRICT 1: SLUM MARKET"

[node name="CrewCountLabel" type="Label" parent="VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 14
text = "CREW: 1 / 2"

[node name="GoldLabel" type="Label" parent="VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.85, 0, 1)
theme_override_font_sizes/font_size = 14
text = "CREDITS: 10 (+1 Interest)"

[node name="LockInBtn" type="Button" parent="VBox/TopBar"]
custom_minimum_size = Vector2(160, 32)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.1, 0.4, 1)
theme_override_font_sizes/font_size = 12
text = "[BREACH / LOCK IN]"

[node name="MainBody" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="BoardArea" type="VBoxContainer" parent="VBox/MainBody"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="FieldSection" type="VBoxContainer" parent="VBox/MainBody/BoardArea"]
layout_mode = 2

[node name="Label" type="Label" parent="VBox/MainBody/BoardArea/FieldSection"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 11
text = "FIELDED OPERATIVES:"

[node name="FieldContainer" type="HBoxContainer" parent="VBox/MainBody/BoardArea/FieldSection"]
custom_minimum_size = Vector2(0, 240)
layout_mode = 2
theme_override_constants/separation = 8

[node name="BenchSection" type="VBoxContainer" parent="VBox/MainBody/BoardArea"]
layout_mode = 2

[node name="Label" type="Label" parent="VBox/MainBody/BoardArea/BenchSection"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.7, 1)
theme_override_font_sizes/font_size = 10
text = "BENCH RESERVES:"

[node name="BenchContainer" type="HBoxContainer" parent="VBox/MainBody/BoardArea/BenchSection"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="AugmentTray" type="VBoxContainer" parent="VBox/MainBody/BoardArea"]
layout_mode = 2

[node name="Label" type="Label" parent="VBox/MainBody/BoardArea/AugmentTray"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.3, 1, 1)
theme_override_font_sizes/font_size = 10
text = "AUGMENT INVENTORY (Select chip, then click unit slot to equip):"

[node name="AugmentContainer" type="HBoxContainer" parent="VBox/MainBody/BoardArea/AugmentTray"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
theme_override_constants/separation = 6

[node name="ShopSection" type="VBoxContainer" parent="VBox/MainBody/BoardArea"]
layout_mode = 2
size_flags_vertical = 10

[node name="ShopControls" type="HBoxContainer" parent="VBox/MainBody/BoardArea/ShopSection"]
layout_mode = 2

[node name="Label" type="Label" parent="VBox/MainBody/BoardArea/ShopSection/ShopControls"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.85, 0, 1)
theme_override_font_sizes/font_size = 11
text = "BLACK MARKET / CREW RECRUITMENT:"

[node name="RerollBtn" type="Button" parent="VBox/MainBody/BoardArea/ShopSection/ShopControls"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "REROLL (2g)"

[node name="ShopContainer" type="HBoxContainer" parent="VBox/MainBody/BoardArea/ShopSection"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
theme_override_constants/separation = 8

[node name="Sidebar" type="VBoxContainer" parent="VBox/MainBody"]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2

[node name="SynergyTrackerHUD" parent="VBox/MainBody/Sidebar" instance=ExtResource("2_hud")]
layout_mode = 2
size_flags_vertical = 3

[node name="StatusLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 11
text = "Welcome to Cyberstack Prep Phase. Assemble your crew."

[connection signal="pressed" from="VBox/TopBar/LockInBtn" to="." method="_on_lock_in_pressed"]
[connection signal="pressed" from="VBox/MainBody/BoardArea/ShopSection/ShopControls/RerollBtn" to="." method="_on_reroll_pressed"]
