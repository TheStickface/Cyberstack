[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/screens/TitleScreen.gd" id="1_title"]

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.015, 0.06, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1

[node name="CenterContainer" type="CenterContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="VBox" type="VBoxContainer" parent="VBox/CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="TitleLabel" type="Label" parent="VBox/CenterContainer/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 48
text = "CYBERSTACK"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="VBox/CenterContainer/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.3, 1, 1)
theme_override_font_sizes/font_size = 14
text = "STACK OR DIE IN THE NEON NOIR"
horizontal_alignment = 1

[node name="MenuButtons" type="VBoxContainer" parent="VBox/CenterContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ContinueBtn" type="Button" parent="VBox/CenterContainer/VBox/MenuButtons"]
visible = false
custom_minimum_size = Vector2(240, 40)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0, 1)
theme_override_font_sizes/font_size = 12
text = "► CONTINUE ACTIVE RUN"

[node name="StartBtn" type="Button" parent="VBox/CenterContainer/VBox/MenuButtons"]
custom_minimum_size = Vector2(240, 40)
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 12
text = "[INITIATE JOB / NEW RUN]"

[node name="CodexBtn" type="Button" parent="VBox/CenterContainer/VBox/MenuButtons"]
custom_minimum_size = Vector2(240, 36)
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.4, 1, 1)
theme_override_font_sizes/font_size = 11
text = "CYBER-CODEX & ARCHIVES"

[node name="QuitBtn" type="Button" parent="VBox/CenterContainer/VBox/MenuButtons"]
custom_minimum_size = Vector2(240, 32)
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.7, 1)
theme_override_font_sizes/font_size = 11
text = "EXIT SYSTEM"

[node name="Footer" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.3, 0.4, 1)
theme_override_font_sizes/font_size = 10
text = "v0.1.0 • Godot 4.6 Engine • Cyberstack Game Core"
horizontal_alignment = 1

[connection signal="pressed" from="VBox/CenterContainer/VBox/MenuButtons/ContinueBtn" to="." method="_on_continue_btn_pressed"]
[connection signal="pressed" from="VBox/CenterContainer/VBox/MenuButtons/StartBtn" to="." method="_on_start_btn_pressed"]
[connection signal="pressed" from="VBox/CenterContainer/VBox/MenuButtons/CodexBtn" to="." method="_on_codex_btn_pressed"]
[connection signal="pressed" from="VBox/CenterContainer/VBox/MenuButtons/QuitBtn" to="." method="_on_quit_btn_pressed"]
