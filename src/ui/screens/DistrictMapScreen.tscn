[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/ui/screens/DistrictMapScreen.gd" id="1_map"]
[ext_resource type="PackedScene" path="res://src/ui/components/EventModal.tscn" id="2_event"]

[node name="DistrictMapScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_map")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.015, 0.05, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="TopBar" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="DistrictTitle" type="Label" parent="Margin/VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 18
text = "DISTRICT 1: SLUM MARKET"

[node name="CrewCountLabel" type="Label" parent="Margin/VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.3, 1, 1)
theme_override_font_sizes/font_size = 14
text = "CREW: 1 / 2"

[node name="GoldLabel" type="Label" parent="Margin/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.85, 0, 1)
theme_override_font_sizes/font_size = 14
text = "CREDITS: 12"

[node name="ManageCrewBtn" type="Button" parent="Margin/VBox/TopBar"]
custom_minimum_size = Vector2(160, 34)
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 11
text = "⚙ MANAGE CREW / SHOP"

[node name="CenterArea" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12
alignment = 1

[node name="MapLabel" type="Label" parent="Margin/VBox/CenterArea"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.65, 0.75, 1)
theme_override_font_sizes/font_size = 13
text = "DISTRICT ENCOUNTER SEQUENCE (Click waypoint to review):"

[node name="MapScroll" type="ScrollContainer" parent="Margin/VBox/CenterArea"]
custom_minimum_size = Vector2(0, 160)
layout_mode = 2
size_flags_vertical = 3
vertical_scroll_mode = 0

[node name="NodesContainer" type="HBoxContainer" parent="Margin/VBox/CenterArea/MapScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 16
alignment = 1

[node name="BottomBar" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ActionBtn" type="Button" parent="Margin/VBox/BottomBar"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "ENTER COMBAT [⚔ FIGHT]"

[node name="StatusLabel" type="Label" parent="Margin/VBox/BottomBar"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.75, 0.85, 1)
theme_override_font_sizes/font_size = 12
text = "Select action to proceed through the district."
horizontal_alignment = 1

[node name="EventModal" parent="." instance=ExtResource("2_event")]
visible = false
layout_mode = 1

[connection signal="pressed" from="Margin/VBox/TopBar/ManageCrewBtn" to="." method="_on_manage_crew_btn_pressed"]
[connection signal="pressed" from="Margin/VBox/BottomBar/ActionBtn" to="." method="_on_action_btn_pressed"]
