[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/screens/RunEndScreen.gd" id="1_end"]

[node name="RunEndScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_end")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.015, 0.06, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1

[node name="Center" type="CenterContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="VBox" type="VBoxContainer" parent="VBox/Center"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="TitleLabel" type="Label" parent="VBox/Center/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 32
text = "MISSION ACCOMPLISHED"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="VBox/Center/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.3, 1, 1)
theme_override_font_sizes/font_size = 13
text = "All city districts breached and secured."
horizontal_alignment = 1

[node name="StatsLabel" type="Label" parent="VBox/Center/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Districts Cleared: 4 / 4
Fights Won: 12
Bosses Defeated: 4
Total Credits Earned: 84"
horizontal_alignment = 1

[node name="ButtonsRow" type="VBoxContainer" parent="VBox/Center/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="QuickRetryBtn" type="Button" parent="VBox/Center/VBox/ButtonsRow"]
custom_minimum_size = Vector2(240, 42)
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 13
text = "↺ QUICK RETRY MISSION"

[node name="ReturnBtn" type="Button" parent="VBox/Center/VBox/ButtonsRow"]
custom_minimum_size = Vector2(240, 36)
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.4, 1, 1)
theme_override_font_sizes/font_size = 11
text = "RETURN TO MAIN TERMINAL"

[connection signal="pressed" from="VBox/Center/VBox/ButtonsRow/QuickRetryBtn" to="." method="_on_quick_retry_btn_pressed"]
[connection signal="pressed" from="VBox/Center/VBox/ButtonsRow/ReturnBtn" to="." method="_on_return_btn_pressed"]
