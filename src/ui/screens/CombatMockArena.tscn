theme_override_font_sizes/font_size = 15
text = "DISTRICT 1 COMBAT ARENA"

[node name="CombatTypeLabel" type="Label" parent="Margin/VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.2, 0.4, 1)
theme_override_font_sizes/font_size = 14
text = "⚔ SECURITY PATROL CLASH"

[node name="TimerLabel" type="Label" parent="Margin/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.85, 0, 1)
theme_override_font_sizes/font_size = 14
text = "TIME: 00:00"
horizontal_alignment = 2

[node name="SpeedBtn" type="Button" parent="Margin/VBox/TopBar"]
custom_minimum_size = Vector2(80, 30)
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "SPEED: 1x"

[node name="SkipBtn" type="Button" parent="Margin/VBox/TopBar"]
custom_minimum_size = Vector2(110, 30)
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.4, 1, 1)
theme_override_font_sizes/font_size = 11
text = "⚡ FAST RESOLVE"

[node name="Arena" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="PlayerSide" type="VBoxContainer" parent="Margin/VBox/Arena"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="PlayerHeader" type="Label" parent="Margin/VBox/Arena/PlayerSide"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.95, 0.83, 1)
theme_override_font_sizes/font_size = 12
